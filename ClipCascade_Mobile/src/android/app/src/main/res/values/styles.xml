<resources>

    <!--
         Shared application palette. API-specific system-bar attributes are
         layered in values-v27 and values-v29 so API 26 never inflates unknown
         framework attributes.
    -->
    <style name="AppTheme.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/background_setup_surface</item>
        <item name="android:colorBackground">@color/background_setup_surface</item>
        <item name="android:textColorPrimary">@color/background_setup_text_primary</item>
        <item name="android:textColorSecondary">@color/background_setup_text_secondary</item>
        <item name="colorAccent">@color/background_setup_accent</item>
        <item name="colorControlNormal">@color/background_setup_text_secondary</item>
        <item name="colorControlActivated">@color/background_setup_accent</item>
        <item name="colorButtonNormal">@color/background_setup_button</item>
        <item name="android:statusBarColor">@color/background_setup_chrome</item>
        <item name="android:navigationBarColor">@color/background_setup_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base" />
    <style name="Theme.ClipCascade.BackgroundSetup" parent="AppTheme" />

    <style name="Theme.TransparentActivity" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
